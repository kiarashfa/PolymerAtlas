---
// Molecule lookup: an identifier or a pasted SMILES in, a drawn structure
// and RDKit's descriptors out. Small molecules only — monomers, solvents,
// additives. The Atlas's own polymer data is never touched by this page.
//
// Two build-time indexes are handed to the client so the tool knows about
// the encyclopedia around it:
//   * polymer names/aliases — because PubChem answers "polystyrene" with the
//     STYRENE monomer, which on a polymer site is actively misleading;
//   * monomer names — so looking one up shows which entries are built from it.
import ToolPage from '../../components/templates/ToolPage.astro';
import { loadPolymers, entryPath, splitTitle, bareName } from '../../lib/content';

const polymers = await loadPolymers();

const polymerIndex: Record<string, { title: string; path: string }> = {};
const monomerIndex: Record<string, { title: string; path: string }[]> = {};

for (const entry of polymers) {
  const title = bareName(splitTitle(entry.narrative.data.name).title);
  const target = { title, path: entryPath('polymer', entry.data.id) };

  const terms = [
    title,
    ...(entry.data.abbreviation ?? []),
    ...(entry.data.synonyms ?? []),
    ...(entry.data.aliases ?? []).map((a) => a.name),
  ];
  for (const term of terms) {
    const key = term.trim().toLowerCase();
    // Only the bare term, never a parenthetical gloss like
    // "Styrofoam (expanded-foam trade name)".
    if (key && !key.includes('(')) polymerIndex[key] ??= target;
  }

  for (const monomer of entry.data.monomer ?? []) {
    const key = monomer.name.trim().toLowerCase();
    if (!key) continue;
    (monomerIndex[key] ??= []).push(target);
  }
}

const examples = [
  { label: 'Styrene', query: 'styrene' },
  { label: 'Methyl methacrylate', query: 'methyl methacrylate' },
  { label: 'Vinyl chloride', query: 'vinyl chloride' },
  { label: 'ε-Caprolactone', query: 'epsilon-caprolactone' },
  { label: 'Bisphenol A', query: 'bisphenol A' },
  { label: 'A SMILES', query: 'OC(=O)C=C' },
];
---

<ToolPage
  title="Molecule Lookup"
  description="Draw any small molecule and read its descriptors — by name, CAS number, InChIKey, or a pasted SMILES string."
  eyebrow="Tools"
  lede="Give it a name, a CAS number, an InChIKey or a SMILES string, and it returns the structure drawn, along with what RDKit can measure about it."
>
  <div class="tool-body">
    <form class="tool-card tool-form" data-lookup-form>
      <label class="tool-label u-caps" for="mol-query">Name, CAS number, InChIKey or SMILES</label>
      <div class="tool-input-row">
        <input
          class="tool-input"
          id="mol-query"
          name="query"
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder="styrene"
        />
        <button class="tool-submit" type="submit">Look up</button>
      </div>
      <p class="tool-hint">
        Names go to PubChem and the NCI resolver; a SMILES string is recognised on sight and used
        directly.
      </p>
      <div class="tool-examples">
        <span class="tool-examples-label u-caps">Try</span>
        {
          examples.map((e) => (
            <button class="tool-chip" type="button" data-example={e.query}>
              {e.label}
            </button>
          ))
        }
      </div>

      <div class="tool-engine" data-engine-control>
        <span class="tool-engine-label u-caps">Engine</span>
        <div class="tool-engine-pair">
          <button class="menu-pair-btn" type="button" data-engine="server">Service</button>
          <button class="menu-pair-btn" type="button" data-engine="local">In-browser</button>
        </div>
        <p class="tool-engine-note" data-engine-note></p>
      </div>
    </form>

    <p class="tool-status" data-status role="status" aria-live="polite"></p>

    <div class="tool-result" data-result hidden>
      <div class="tool-card mol-card">
        <div class="mol-figure">
          <div class="mol-draw" data-draw></div>
          <p class="mol-caption" data-caption></p>
        </div>
        <dl class="fact-table mol-facts" data-identity></dl>
      </div>

      <section class="tool-card">
        <h2 class="tool-card-head u-caps">Computed descriptors</h2>
        <dl class="fact-table" data-descriptors></dl>
        <p class="tool-note">
          Calculated from the structure by RDKit, not measured. They describe the small molecule
          shown, never a polymer made from it — chain length, tacticity and morphology decide bulk
          behaviour, and none of them is visible here.
        </p>
      </section>
    </div>

    <section class="tool-card tool-colophon">
      <h2 class="tool-card-head u-caps">About this tool</h2>
      <p>
        Structures are drawn and measured by <a href="https://www.rdkit.org/" rel="noopener">RDKit</a
        >. A name is resolved by <a href="https://pubchem.ncbi.nlm.nih.gov/" rel="noopener">PubChem</a
        > first and the <a href="https://cactus.nci.nih.gov/chemical/structure" rel="noopener"
          >NCI Chemical Identifier Resolver</a
        > second, so whatever you type is sent to them to be looked up. There is no account and
        nothing to sign in to.
      </p>
    </section>
  </div>

  {/* Data, not code — inline on purpose so the client script can read the
      build-time indexes without a second request. */}
  <script is:inline type="application/json" data-polymer-index set:html={JSON.stringify(polymerIndex)} />
  <script is:inline type="application/json" data-monomer-index set:html={JSON.stringify(monomerIndex)} />
</ToolPage>

<script>
  import {
    describeMolecule,
    isRepeatUnit,
    isMultiFragment,
    storedEngine,
    setStoredEngine,
  } from '../../lib/chem-api';
  import { isLocalEngineLoaded } from '../../lib/rdkit-local';
  import { descriptorRows } from '../../lib/descriptors';

  interface AtlasTarget {
    title: string;
    path: string;
  }

  function readIndex<T>(attribute: string): T {
    const node = document.querySelector(`[${attribute}]`);
    try {
      return JSON.parse(node?.textContent ?? '{}') as T;
    } catch {
      return {} as T;
    }
  }

  function wire() {
    const form = document.querySelector<HTMLFormElement>('[data-lookup-form]');
    if (!form || form.dataset.wired) return;
    form.dataset.wired = 'true';

    const polymerIndex = readIndex<Record<string, AtlasTarget>>('data-polymer-index');
    const monomerIndex = readIndex<Record<string, AtlasTarget[]>>('data-monomer-index');

    const input = form.querySelector<HTMLInputElement>('.tool-input')!;
    const submit = form.querySelector<HTMLButtonElement>('.tool-submit')!;
    const status = document.querySelector<HTMLElement>('[data-status]')!;
    const result = document.querySelector<HTMLElement>('[data-result]')!;
    const draw = result.querySelector<HTMLElement>('[data-draw]')!;
    const caption = result.querySelector<HTMLElement>('[data-caption]')!;
    const identity = result.querySelector<HTMLElement>('[data-identity]')!;
    const descriptors = result.querySelector<HTMLElement>('[data-descriptors]')!;

    const engineControl = document.querySelector<HTMLElement>('[data-engine-control]')!;
    const engineNote = engineControl.querySelector<HTMLElement>('[data-engine-note]')!;

    function setStatus(text: string, kind: 'working' | 'error' | 'note' | 'none') {
      status.textContent = text;
      status.className = `tool-status${kind === 'none' ? '' : ` tool-status--${kind}`}`;
    }

    /** Say which engine is answering, and what that costs. */
    function syncEngine() {
      const engine = storedEngine();
      engineControl.querySelectorAll<HTMLElement>('[data-engine]').forEach((b) => {
        b.classList.toggle('is-active', b.dataset.engine === engine);
      });
      engineNote.textContent =
        engine === 'local'
          ? isLocalEngineLoaded()
            ? 'RDKit is running in this browser — structures are drawn with no network at all. Looking a NAME up still needs the service, because the name has to be resolved somewhere.'
            : 'RDKit will run in this browser. About 6.8 MB downloads once and is then cached, after which pasted structures work offline. Looking a NAME up still needs the service.'
          : 'Structures are drawn by the service, so nothing is downloaded here.';
    }

    /** Offer the other engine when the service is the thing that failed. */
    function offerLocalEngine(query: string) {
      if (storedEngine() === 'local') return;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'tool-inline-action';
      button.textContent = 'Use the in-browser engine instead';
      button.addEventListener('click', () => {
        setStoredEngine('local');
        syncEngine();
        void lookup(query);
      });
      status.append(' ', button);
    }

    function row(label: string, value: string, options: { mono?: boolean; hint?: string } = {}) {
      const wrap = document.createElement('div');
      wrap.className = 'fact';
      const dt = document.createElement('dt');
      dt.className = 'fact-label';
      dt.textContent = label;
      if (options.hint) dt.title = options.hint;
      const dd = document.createElement('dd');
      dd.className = options.mono ? 'fact-value fact-value--mono' : 'fact-value';
      dd.textContent = value;
      wrap.append(dt, dd);
      return wrap;
    }

    // Whatever the reader typed, does the Atlas already have a page for it?
    function atlasNotice(query: string, smiles: string): string {
      const key = query.trim().toLowerCase();

      const polymer = polymerIndex[key];
      if (polymer) {
        return (
          `“${query}” is a polymer in this Atlas, and what you are looking at is its monomer — ` +
          `the small molecule chemical databases answer that name with. ` +
          `<a href="${polymer.path}">Read the ${polymer.title} entry</a> for the polymer itself.`
        );
      }

      const built = monomerIndex[key] ?? [];
      if (built.length) {
        const links = built.map((t) => `<a href="${t.path}">${t.title}</a>`).join(', ');
        return `In this Atlas, ${links} ${built.length > 1 ? 'are' : 'is'} built from it.`;
      }

      if (isRepeatUnit(smiles)) {
        return (
          'The <code>*</code> marks show where the chain continues, so this is a repeat unit ' +
          'rather than a discrete molecule. Mass and formula describe the unit; InChI does not ' +
          'exist for an open fragment.'
        );
      }
      return '';
    }

    async function lookup(query: string) {
      const trimmed = query.trim();
      if (!trimmed) return;

      submit.disabled = true;
      setStatus('Looking it up…', 'working');

      // 'auto' guesses, then checks its guess against the service.
      const response = await describeMolecule(trimmed, 'auto', { width: 380, height: 300 });
      submit.disabled = false;

      if (!response.ok) {
        result.hidden = true;
        const { code, message } = response.error;
        setStatus(
          code === 'not_found'
            ? `Nothing found for “${trimmed}”. Try another spelling, a CAS number, or paste a SMILES string.`
            : code === 'upstream_unavailable' || code === 'network' || code === 'timeout'
              ? `${message} The encyclopedia itself is unaffected — only this tool needs that service.`
              : message,
          'error'
        );
        if (code === 'upstream_unavailable' || code === 'network' || code === 'timeout')
          offerLocalEngine(trimmed);
        return;
      }

      const data = response.data;
      setStatus('', 'none');
      // The engine may have finished loading during this lookup, which changes
      // what the note beneath the control can honestly claim.
      syncEngine();

      draw.innerHTML = data.svg.trim().startsWith('<svg') ? data.svg : '';
      const notice = atlasNotice(trimmed, data.smiles);
      caption.innerHTML = notice;
      caption.hidden = !notice;

      identity.replaceChildren(
        row('Formula', data.formula),
        row('Molecular weight', `${data.molecular_weight} g/mol`),
        row('Exact mass', `${data.exact_mass} g/mol`),
        row('SMILES', data.smiles, { mono: true }),
        ...(data.inchikey ? [row('InChIKey', data.inchikey, { mono: true })] : []),
        ...(data.inchi ? [row('InChI', data.inchi, { mono: true })] : []),
        ...(data.resolved_from
          ? [row('Resolved by', data.resolved_from === 'pubchem' ? 'PubChem' : 'NCI resolver')]
          : [])
      );

      if (isMultiFragment(data.smiles)) {
        identity.append(
          row(
            'Note',
            'Several disconnected fragments — the values below describe all of them together.'
          )
        );
      }

      descriptors.replaceChildren(
        ...descriptorRows(data.descriptors).map((d) =>
          row(d.label, d.unit ? `${d.value} ${d.unit}` : d.value, { hint: d.hint })
        )
      );

      result.hidden = false;
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      void lookup(input.value);
    });

    // Enter submits. Implicit form submission would usually cover this, but
    // stating it removes any doubt: preventDefault first so the browser's own
    // submission cannot also fire and run the request twice.
    form.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      if (!(e.target as Element | null)?.closest('input')) return;
      e.preventDefault();
      form.requestSubmit();
    });

    form.addEventListener('click', (e) => {
      const chip = (e.target as Element | null)?.closest<HTMLElement>('[data-example]');
      if (!chip?.dataset.example) return;
      input.value = chip.dataset.example;
      void lookup(chip.dataset.example);
    });

    engineControl.addEventListener('click', (e) => {
      const button = (e.target as Element | null)?.closest<HTMLElement>('[data-engine]');
      if (!button?.dataset.engine) return;
      setStoredEngine(button.dataset.engine === 'local' ? 'local' : 'server');
      syncEngine();
    });
    syncEngine();

    // Deep link: /tools/molecule/?q=styrene
    const initial = new URLSearchParams(location.search).get('q');
    if (initial) {
      input.value = initial;
      void lookup(initial);
    }
  }

  document.addEventListener('astro:page-load', wire);
</script>
