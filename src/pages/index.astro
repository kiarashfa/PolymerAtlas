---
// The home page: the Atlas as one instrument. The dial carries every entry in
// its era; beneath it one entry opens as a spread for the day, and the page
// closes on the three ways through the archive beside the three tools.
import Base from '../layouts/Base.astro';
import Astrolabe from '../components/blocks/Astrolabe.astro';
import OpeningSpread from '../components/blocks/OpeningSpread.astro';
import WaysIn from '../components/blocks/WaysIn.astro';
import { eras, href, loadFamilies, loadPeople } from '../lib/content';
import { catalogueIndex } from '../lib/derived';
import { SITE_TAGLINE } from '../lib/site';

const records = await catalogueIndex();
const families = (await loadFamilies()).filter((f) => f.data.membership.axis === 'chemical_family');
const people = await loadPeople();

const stats = [
  { n: records.length, label: 'entries', href: href('/catalogue/') },
  { n: eras.length, label: 'eras', href: href('/timeline/') },
  { n: families.length, label: 'families', href: href('/families/') },
  { n: people.length, label: 'pioneers', href: href('/families/#pioneers') },
];

const description =
  `Atlas of Polymers, ${SITE_TAGLINE}: ${records.length} entries across seven eras, ` +
  'each opening with the history of its year and closing on cited property data.';
---

<Base title="Atlas of Polymers" description={description} home>
  <main class="home">
    <section class="home-hero">
      <div class="home-intro">
        <p class="home-eyebrow u-caps">An encyclopedia with a memory</p>
        <h1 class="home-title">Atlas <em>of</em> Polymers</h1>
        <p class="home-sub">
          A history-narrated encyclopedia of the polymers that made the modern world. Every mark on
          the dial is an entry, set in its own era; point to one to read it.
        </p>
        <div class="home-actions">
          <a class="btn btn--foil" href={href('/catalogue/')}>Open the catalogue</a>
          <a class="btn" href={href('/constellation/')}>Explore the constellation</a>
        </div>
        <div class="home-stats">
          {
            stats.map((s) => (
              <a class="home-stat" href={s.href}>
                <span class="home-stat-n">{s.n}</span>
                <span class="home-stat-label">{s.label}</span>
              </a>
            ))
          }
        </div>
      </div>
      <Astrolabe />
    </section>

    <OpeningSpread />

    <WaysIn />
  </main>
</Base>
