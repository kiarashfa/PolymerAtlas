---
// Site-wide chrome for the Atlas of Polymers ("Edition" design).
// Owns: head metadata (incl. link-preview cards, icons, the web manifest and
// analytics), theme + presentation-style pre-paint stamps, header (title on
// the left; nav, then a hairline, then search + EditionMenu icons on the
// right), footer, View Transitions, and the three global behaviors (section
// collapse, citation-click, rail scrollspy).
import { ClientRouter } from 'astro:transitions';
import AtlasMark from '../components/ui/AtlasMark.astro';
import EditionMenu from '../components/ui/EditionMenu.astro';
import SearchOverlay from '../components/ui/SearchOverlay.astro';
import MolPopover from '../components/ui/MolPopover.astro';
import { href } from '../lib/content';
import {
  SITE_NAME,
  SITE_TAGLINE,
  COPYRIGHT_HOLDER,
  COPYRIGHT_YEARS,
  GA_MEASUREMENT_ID,
  PAPER_LIGHT,
} from '../lib/site';
import '../styles/tokens.css';
import '../styles/edition.css';

interface Props {
  title: string;
  description: string;
  /** Marks the matching header nav link with aria-current. */
  current?: 'catalogue' | 'timeline' | 'constellation' | 'families';
  /** The home page carries the bare site name as its title. */
  home?: boolean;
}
const { title, description, current, home = false } = Astro.props;
const pageTitle = home ? SITE_NAME : `${title} · ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Link previews need absolute URLs; the card is the same for every page.
const socialImage = new URL(href('/og-image.png'), Astro.site);
---

<!doctype html>
<html lang="en" class="variant-gilt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {/* One SVG mark, carrying both palettes and switching itself on
        prefers-color-scheme, so the tab reads on light and dark chrome alike;
        the .ico and PNGs are its rasters for places that cannot read SVG. */}
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="icon" href={href('/favicon.ico')} sizes="48x48" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />
    {/* Follows the resolved theme: the menu script rewrites it from the
        page's own paper whenever the theme or presentation style changes. */}
    <meta name="theme-color" content={PAPER_LIGHT} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={home ? 'website' : 'article'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME}: ${SITE_TAGLINE}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {
      home && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'WebSite',
            name: SITE_NAME,
            url: canonical.href,
            description,
          })}
        />
      )
    }
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
    ></script>
    <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', GA_MEASUREMENT_ID);
    </script>
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('pa-theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
          const v = localStorage.getItem('pa-variant');
          if (v === 'vellum' || v === 'atelier') {
            document.documentElement.classList.remove('variant-gilt');
            document.documentElement.classList.add('variant-' + v);
          }
          if (localStorage.getItem('pa-glaze') === 'off')
            document.documentElement.classList.add('no-glaze');
        } catch {}
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-head">
      <a class="site-title" href={href('/')}>
        <AtlasMark class="site-mark" size={30} />
        Atlas of Polymers
      </a>
      <nav class="site-nav" aria-label="Site">
        <a href={href('/catalogue/')} aria-current={current === 'catalogue' ? 'page' : undefined}>
          Catalogue
        </a>
        <span class="nav-sep" aria-hidden="true">·</span>
        <a href={href('/timeline/')} aria-current={current === 'timeline' ? 'page' : undefined}>
          Timeline
        </a>
        <span class="nav-sep" aria-hidden="true">·</span>
        <a
          href={href('/constellation/')}
          aria-current={current === 'constellation' ? 'page' : undefined}
        >
          Constellation
        </a>
        <span class="nav-sep" aria-hidden="true">·</span>
        <a href={href('/families/')} aria-current={current === 'families' ? 'page' : undefined}>
          Families
        </a>
      </nav>
      <span class="head-divider" aria-hidden="true"></span>
      <div class="head-tools">
        <SearchOverlay />
        <EditionMenu />
      </div>
    </header>
    <div id="main">
      <slot />
    </div>
    <MolPopover />
    <footer class="site-foot">
      <div class="foot-row">
        <a class="foot-brand" href={href('/')}>
          <AtlasMark size={18} />
          {SITE_NAME}
        </a>
        <nav class="foot-links" aria-label="Footer">
          <a href={href('/catalogue/')}>Catalogue</a>
          <a href={href('/tools/')}>Tools</a>
          <a href={href('/about/')}>About</a>
        </nav>
        <span class="foot-copy">© {COPYRIGHT_YEARS} {COPYRIGHT_HOLDER}</span>
      </div>
      <p class="foot-tag">{SITE_NAME}, {SITE_TAGLINE}.</p>
    </footer>
  </body>
</html>

<script>
  // Collapsible sections — delegated so it survives View Transitions swaps.
  // Server HTML is always fully expanded (SEO); JS only ever collapses.
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element | null)?.closest('.ed-toggle');
    if (!btn) return;
    const section = btn.closest('.ed-section');
    if (!section) return;
    const collapsed = section.classList.toggle('is-collapsed');
    btn.setAttribute('aria-expanded', String(!collapsed));
  });

  // Deep links into collapsed sections: any in-page anchor (rail links,
  // numeric citation marks, …) whose target sits inside a collapsed
  // section card expands it first, so the browser scrolls somewhere
  // visible. Runs before the default scroll (handlers fire before the
  // default action).
  function expandSectionFor(id: string) {
    const target = document.getElementById(id);
    const section = target?.closest('.ed-section');
    if (section?.classList.contains('is-collapsed')) {
      section.classList.remove('is-collapsed');
      section.querySelector('.ed-toggle')?.setAttribute('aria-expanded', 'true');
    }
  }
  document.addEventListener('click', (e) => {
    const link = (e.target as Element | null)?.closest('a[href*="#"]');
    if (!link) return;
    const id = (link.getAttribute('href') ?? '').split('#')[1];
    if (id) expandSectionFor(id);
  });
  window.addEventListener('hashchange', () => {
    const id = location.hash.slice(1);
    if (id) expandSectionFor(id);
  });

  // Section-rail scrollspy (highlight the section currently in view).
  let spy: IntersectionObserver | null = null;
  function initRailSpy() {
    spy?.disconnect();
    const rail = document.querySelector('.rail');
    if (!rail) return;
    const links = new Map<string, Element>();
    rail.querySelectorAll('a[href*="#"]').forEach((a) => {
      const id = (a.getAttribute('href') ?? '').split('#')[1];
      if (id) links.set(id, a);
    });
    spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const link = links.get(entry.target.id);
          if (!link) continue;
          if (entry.isIntersecting) {
            rail.querySelectorAll('.is-active').forEach((el) => el.classList.remove('is-active'));
            link.classList.add('is-active');
          }
        }
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );
    document.querySelectorAll('[data-spy]').forEach((s) => spy!.observe(s));
  }
  document.addEventListener('astro:page-load', initRailSpy);
</script>
