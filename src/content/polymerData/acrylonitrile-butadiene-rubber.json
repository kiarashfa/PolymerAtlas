  "synthesis": {
    "polymerization_type": "free-radical emulsion copolymerization",
    "common_monomers": [
      "acrylonitrile",
      "1,3-butadiene"
    ],
    "catalysts": [
      "radical activators/persulfate-type initiators"
    ],
    "industrial_process_notes": "Developed in 1931 at BASF and Bayer, with commercial German production from 1935. Produced via emulsion polymerization at 30-40°C ('hot' NBR) or 5-15°C ('cold' NBR): emulsifier, acrylonitrile, butadiene, radical activators, and catalyst combined in water; reaction is halted at ~70% conversion by termination agents, followed by monomer recovery and coagulation into crumb rubber.",
    "synthesis_scheme_image": null
  },
