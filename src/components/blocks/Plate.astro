---
// A historical photograph set into a narrative, mounted like a plate in a
// fine edition: small-caps plate label, the photograph itself on the page
// (no card, no mat), caption below, credit below that.
//
// Used from MDX as <Plate src="~/assets/polymers/<id>/<slug>.webp" … /> with
// a blank line either side. The "~/assets/…" path is resolved through
// Astro's image pipeline, so every photograph is optimised, hashed and
// self-hosted -- Wikimedia is never hotlinked.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  source_url?: string;
  author?: string;
  license?: string;
  attribution_text?: string;
  /** Small-caps label above the photograph, e.g. "Plate III". */
  label?: string;
}
const { src, alt, caption, source_url, author, license, attribution_text, label } =
  Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/**/*.{png,jpg,jpeg,webp,avif,svg}'
);
const key = src.replace(/^~\//, '../../');
const loader = images[key];
if (!loader) throw new Error(`Plate: unknown asset "${src}" (resolved to "${key}")`);
const image = (await loader()).default;

// Under the plate goes only where it came from. Author and licence are set
// out in full in the Illustrations list at the foot of the page (see
// ImageCredits.astro) — five author-and-licence lines down one narrative
// compete with the captions and say nothing the reader wants there.
const host = source_url?.includes('commons.wikimedia.org')
  ? 'Wikimedia Commons'
  : source_url?.replace(/^https?:\/\/(www\.)?/, '').split('/')[0];
const credit = host ?? attribution_text ?? author ?? license ?? null;
---

<figure class="plate">
  {label && <p class="plate-label">{label}</p>}
  <span class="plate-glass">
    <Image src={image} alt={alt} class="plate-img" widths={[560, 900, 1400]} />
  </span>
  {
    (caption || credit) && (
      <figcaption class="plate-caption">
        {caption}
        {credit && (
          <span class="plate-credit">
            {source_url ? (
              <a href={source_url} rel="noopener">
                {credit}
              </a>
            ) : (
              <>{credit}</>
            )}
          </span>
        )}
      </figcaption>
    )
  }
</figure>
