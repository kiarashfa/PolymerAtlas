---
// The single panel every <Mol> trigger on the page shares. Rendered once by
// Base.astro; inert and empty until a reader opens one.
//
// Deliberately quiet on failure: this depends on an outside service, and a
// narrative must never look broken because a popup could not load. When the
// service is unreachable the panel says so in one line and offers the
// molecule tool — the sentence around it is unaffected either way.
import { href } from '../../lib/content';
---

<div class="mol-pop" data-mol-pop hidden>
  <div class="mol-pop-panel" role="dialog" aria-label="Molecule" data-mol-panel>
    <button class="mol-pop-close" type="button" data-mol-close aria-label="Close">×</button>
    <h2 class="mol-pop-name" data-mol-pop-name></h2>
    <div class="mol-pop-draw" data-mol-pop-draw></div>
    <dl class="mol-pop-facts" data-mol-pop-facts></dl>
    <p class="mol-pop-state" data-mol-pop-state></p>
    <a class="mol-pop-more" data-mol-pop-more href={href('/tools/molecule/')}>
      Open in the molecule tool →
    </a>
  </div>
</div>

<script>
  // Only pure modules here: lib/content imports astro:content and cannot be
  // bundled for the client. The base-aware tool URL is already rendered into
  // the panel's link above, so the query string is appended to that.
  import { describeMolecule } from '../../lib/chem-api';

  // Which of RDKit's numbers earn their place in a popup: enough to answer
  // "what is this, how big, how greasy, how polar" and nothing more. The
  // molecule tool shows the full set.
  const POPUP_KEYS: { key: string; label: string; decimals?: number }[] = [
    { key: 'logp', label: 'LogP', decimals: 2 },
    { key: 'tpsa', label: 'TPSA', decimals: 1 },
    { key: 'heavy_atoms', label: 'Heavy atoms' },
  ];

  let open = false;
  /** The tool's own URL, as the server rendered it (base path included). */
  let toolBase = '';

  function panelParts() {
    const root = document.querySelector<HTMLElement>('[data-mol-pop]');
    if (!root) return null;
    return {
      root,
      panel: root.querySelector<HTMLElement>('[data-mol-panel]')!,
      name: root.querySelector<HTMLElement>('[data-mol-pop-name]')!,
      draw: root.querySelector<HTMLElement>('[data-mol-pop-draw]')!,
      facts: root.querySelector<HTMLElement>('[data-mol-pop-facts]')!,
      state: root.querySelector<HTMLElement>('[data-mol-pop-state]')!,
      more: root.querySelector<HTMLAnchorElement>('[data-mol-pop-more]')!,
    };
  }

  function close() {
    const parts = panelParts();
    if (!parts) return;
    open = false;
    parts.root.hidden = true;
    document
      .querySelectorAll<HTMLElement>('[data-mol][aria-expanded="true"]')
      .forEach((b) => b.setAttribute('aria-expanded', 'false'));
  }

  /** Sit the panel under the trigger, nudged back inside the viewport. */
  function place(trigger: HTMLElement, panel: HTMLElement) {
    const rect = trigger.getBoundingClientRect();
    const width = panel.offsetWidth;
    const margin = 12;
    const left = Math.min(
      Math.max(margin, rect.left + rect.width / 2 - width / 2),
      window.innerWidth - width - margin
    );
    const below = rect.bottom + window.scrollY + 8;
    const above = rect.top + window.scrollY - panel.offsetHeight - 8;
    const fitsBelow = rect.bottom + panel.offsetHeight + 8 < window.innerHeight;

    panel.style.left = `${left + window.scrollX}px`;
    panel.style.top = `${fitsBelow || above < window.scrollY ? below : above}px`;
  }

  async function show(trigger: HTMLElement) {
    const parts = panelParts();
    const smiles = trigger.dataset.molSmiles;
    const name = trigger.dataset.molName ?? '';
    if (!parts || !smiles) return;

    open = true;
    parts.root.hidden = false;
    trigger.setAttribute('aria-expanded', 'true');
    parts.name.textContent = name;
    parts.draw.innerHTML = '';
    parts.facts.replaceChildren();
    parts.state.textContent = 'Drawing…';
    parts.state.hidden = false;
    toolBase ||= parts.more.getAttribute('href') ?? '';
    parts.more.href = `${toolBase.split('?')[0]}?q=${encodeURIComponent(smiles)}`;
    place(trigger, parts.panel);

    const response = await describeMolecule(smiles, 'smiles', { width: 240, height: 180 });

    // The reader may have closed it, or opened another, while we waited.
    if (!open || trigger.getAttribute('aria-expanded') !== 'true') return;

    if (!response.ok) {
      parts.state.textContent =
        'The structure service is not reachable just now — the entry itself is unaffected.';
      place(trigger, parts.panel);
      return;
    }

    const data = response.data;
    parts.state.hidden = true;
    parts.draw.innerHTML = data.svg.trim().startsWith('<svg') ? data.svg : '';

    const rows: HTMLElement[] = [];
    const add = (label: string, value: string) => {
      const dt = document.createElement('dt');
      dt.textContent = label;
      const dd = document.createElement('dd');
      dd.textContent = value;
      rows.push(dt, dd);
    };
    add('Formula', data.formula);
    add('Mass', `${data.molecular_weight} g/mol`);
    for (const item of POPUP_KEYS) {
      const value = data.descriptors[item.key];
      if (typeof value !== 'number') continue;
      add(item.label, item.decimals !== undefined ? value.toFixed(item.decimals) : String(value));
    }
    parts.facts.replaceChildren(...rows);
    place(trigger, parts.panel);
  }

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    const trigger = target?.closest<HTMLElement>('[data-mol]');

    if (trigger) {
      if (trigger.getAttribute('aria-expanded') === 'true') close();
      else {
        close();
        void show(trigger);
      }
      return;
    }
    if (!target?.closest('[data-mol-panel]')) close();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
  window.addEventListener('resize', close);
  document.addEventListener('astro:page-load', close);
  document.addEventListener('astro:before-swap', close);
</script>
