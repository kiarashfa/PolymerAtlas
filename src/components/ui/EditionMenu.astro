---
// The reader's menu — a colophon-style dropdown behind an elegant trigger
// (three stacked lozenges, the same diamond motif as the timeline's year
// markers; deliberately not a hamburger). Holds the tools and the reading
// preferences that used to crowd the header: the Gilt/Vellum/Atelier
// presentation styles (each option typeset in the face it switches to), and
// one row of four two-way switches (theme, the glazing over narrative
// photographs, the unit system, and where molecules are drawn). Absorbs the
// former VariantToggle + ThemeToggle (same localStorage keys
// 'pa-variant'/'pa-theme'; the Layout's pre-paint head script still applies
// them, and 'pa-glaze', before first paint).
//
// Extensible by design: each `.menu-group` is an independent section with
// its own hairline-flanked label — future entries (links, tools) are added
// as new groups, not squeezed into the header.
//
// The Tools group and the About row are the rows here that NAVIGATE rather
// than switch something. They are shaped to say so at a glance: full-width
// rows with a glyph and a destination arrow, no segmented pair, and no
// active mark — nothing in them is ever "on".
//
// The four switches each show their CURRENT state (icon and word) and flip
// on a click. Each carries the same data-*-set attribute a two-button pair
// would; the script keeps it pointed at the OTHER value, so one click
// handler serves both shapes.
import { VARIANTS } from '../../lib/variants';
import { href } from '../../lib/content';
import { TOOLS as tools } from '../../lib/tools';

// Every state a switch can show: its icon and its word.
const SUN = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.6"></circle><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6"></path></svg>`;
const MOON = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.2 14.5A8.6 8.6 0 0 1 9.5 3.8a8.6 8.6 0 1 0 10.7 10.7z"></path></svg>`;
const CLOUD = `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 18.5h10.2a4 4 0 0 0 .6-7.95A5.6 5.6 0 0 0 6.9 9.6 4.5 4.5 0 0 0 7 18.5z"></path></svg>`;
const WINDOW = `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="2"></rect><path d="M3.5 9h17"></path><path d="M6.2 7h.01M8.4 7h.01" stroke-linecap="round" stroke-width="1.8"></path></svg>`;
const glyph = (g: string) => `<span class="flip-glyph">${g}</span>`;

const switches = [
  {
    label: 'Light',
    attr: 'data-theme-set',
    states: [
      { value: 'light', word: 'Day', icon: SUN },
      { value: 'dark', word: 'Night', icon: MOON },
    ],
  },
  {
    label: 'Glazing',
    attr: 'data-glaze-set',
    states: [
      { value: 'on', word: 'Glazed', icon: glyph('◧') },
      { value: 'off', word: 'Plain', icon: glyph('◫') },
    ],
  },
  {
    label: 'Units',
    attr: 'data-units-set',
    states: [
      { value: 'si', word: 'SI', icon: glyph('°C') },
      { value: 'imperial', word: 'Imperial', icon: glyph('°F') },
    ],
  },
  {
    label: 'Structures',
    attr: 'data-engine-set',
    states: [
      { value: 'server', word: 'Service', icon: CLOUD },
      { value: 'local', word: 'Browser', icon: WINDOW },
    ],
  },
];

// The rows cascade in one beat apart when the panel unfolds; the index is
// carried on each row so inserting a group cannot break the sequence.
let step = 0;
const stagger = () => step++;
---

<div class="head-menu" data-head-menu>
  <button
    class="head-icon-btn"
    type="button"
    aria-label="Reading preferences"
    title="Reading preferences"
    aria-haspopup="true"
    aria-expanded="false"
    data-menu-trigger
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2.8l2.1 2.5L12 7.8 9.9 5.3z"></path>
      <path d="M12 9.5l2.1 2.5-2.1 2.5-2.1-2.5z"></path>
      <path d="M12 16.2l2.1 2.5-2.1 2.5-2.1-2.5z"></path>
    </svg>
  </button>

  <div class="head-menu-panel" aria-label="Reading preferences" data-menu-panel>
    <section class="menu-group" aria-label="Tools">
      <h2 class="menu-group-label u-caps menu-stagger" style={`--i:${stagger()}`}>Tools</h2>
      {
        tools.map((t) => (
          <a class="menu-link menu-stagger" style={`--i:${stagger()}`} href={t.href}>
            <span class="menu-link-glyph" aria-hidden="true">
              {t.glyph}
            </span>
            <span class="menu-option-text">
              <span class="menu-link-name">{t.name}</span>
              <span class="menu-option-note">{t.essence}</span>
            </span>
            <span class="menu-link-arrow" aria-hidden="true">
              →
            </span>
          </a>
        ))
      }
    </section>

    <section class="menu-group" aria-label="Presentation style">
      <h2 class="menu-group-label u-caps menu-stagger" style={`--i:${stagger()}`}>Presentation</h2>
      {
        VARIANTS.map((v) => (
          <button
            class="menu-option menu-stagger"
            style={`--i:${stagger()}`}
            type="button"
            data-variant-btn={v.id}
            title={v.note}
          >
            <span class="menu-option-text">
              <span class={`menu-option-name menu-option-name--${v.id}`}>{v.name}</span>
              <span class="menu-option-note">{v.essence}</span>
            </span>
            <span class="menu-option-mark" aria-hidden="true">✦</span>
          </button>
        ))
      }
    </section>

    {/* The four two-way preferences as one row: each well shows the state
        in force, and a click flips it. Structures says where molecules are
        drawn; the Molecule Lookup page carries the same choice with the full
        explanation, and both write one key and announce the change. */}
    <section class="menu-group" aria-label="Reading">
      <h2 class="menu-group-label u-caps menu-stagger" style={`--i:${stagger()}`}>Reading</h2>
      <div class="flip-row menu-stagger" style={`--i:${stagger()}`}>
        {
          switches.map((sw) => (
            <button
              class="flip"
              type="button"
              {...{ [sw.attr]: sw.states[1].value }}
              data-flip={sw.attr}
              data-states={JSON.stringify(sw.states.map((st) => [st.value, st.word]))}
            >
              <span class="flip-well" aria-hidden="true">
                {sw.states.map((st, i) => (
                  <span class="flip-icon" data-when={st.value} hidden={i !== 0} set:html={st.icon} />
                ))}
              </span>
              {sw.states.map((st, i) => (
                <span class="flip-state" data-when={st.value} hidden={i !== 0}>
                  {st.word}
                </span>
              ))}
              <span class="flip-label u-caps">{sw.label}</span>
            </button>
          ))
        }
      </div>
    </section>

    {/* Last, and the quietest: what the Atlas is, how to reach whoever keeps
        it, and how to support it. Navigation, so it takes the Tools group's
        row shape rather than a toggle's. */}
    <section class="menu-group" aria-label="About">
      <h2 class="menu-group-label u-caps menu-stagger" style={`--i:${stagger()}`}>About</h2>
      <a class="menu-link menu-stagger" style={`--i:${stagger()}`} href={href('/about/')}>
        <span class="menu-link-glyph" aria-hidden="true">❦</span>
        <span class="menu-option-text">
          <span class="menu-link-name">About the Atlas</span>
          <span class="menu-option-note">What this is, and how to get in touch</span>
        </span>
        <span class="menu-link-arrow" aria-hidden="true">→</span>
      </a>
    </section>
  </div>
</div>

<script>
  import { imperialText, siText, storedUnits, UNITS_CHANGE_EVENT } from '../../lib/units';
  import { storedEngine, setStoredEngine, ENGINE_CHANGE_EVENT } from '../../lib/chem-api';

  // All listeners delegated on document — they survive View Transitions.
  const VARIANT_IDS = ['gilt', 'vellum', 'atelier'];

  function applyVariant(v: string) {
    const root = document.documentElement;
    for (const id of VARIANT_IDS) root.classList.toggle(`variant-${id}`, id === v);
  }

  function storedVariant(): string {
    try {
      const v = localStorage.getItem('pa-variant');
      if (v && VARIANT_IDS.includes(v)) return v;
    } catch {
      /* ignore */
    }
    return 'gilt';
  }

  function resolvedTheme(): string {
    const forced = document.documentElement.dataset.theme;
    if (forced === 'light' || forced === 'dark') return forced;
    return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function storedGlaze(): string {
    try {
      if (localStorage.getItem('pa-glaze') === 'off') return 'off';
    } catch {
      /* ignore */
    }
    return 'on';
  }

  function applyGlaze(state: string) {
    document.documentElement.classList.toggle('no-glaze', state === 'off');
  }

  // Rewrite every convertible property value in place. The SI numbers live
  // in data attributes stamped at build time (PropRow); SI text is
  // regenerated through the same assembler that produced the server HTML,
  // so toggling back is byte-identical.
  function applyUnits(system: string) {
    document.querySelectorAll<HTMLElement>('[data-si-unit]').forEach((el) => {
      const num = (s: string | undefined) => (s != null && s !== '' ? Number(s) : null);
      const v = num(el.dataset.siV);
      const min = num(el.dataset.siMin);
      const max = num(el.dataset.siMax);
      const unit = el.dataset.siUnit ?? '';
      const text =
        system === 'imperial'
          ? imperialText(v, min, max, unit)
          : siText(v, min, max, unit);
      if (text !== null) el.textContent = text;
    });
  }

  // Mirror variant / theme / glazing / units onto the menu's active marks.
  function syncMenu() {
    const v = VARIANT_IDS.find((id) =>
      document.documentElement.classList.contains(`variant-${id}`)
    );
    const t = resolvedTheme();
    const u = storedUnits();
    const g = storedGlaze();
    document.querySelectorAll<HTMLElement>('[data-variant-btn]').forEach((b) => {
      b.classList.toggle('is-active', b.dataset.variantBtn === v);
    });
    const now: Record<string, string> = {
      'data-theme-set': t,
      'data-glaze-set': g,
      'data-units-set': u,
      'data-engine-set': storedEngine(),
    };
    // Each switch shows the state in force and is armed with the other one.
    document.querySelectorAll<HTMLElement>('[data-flip]').forEach((b) => {
      const attr = b.dataset.flip!;
      const states: [string, string][] = JSON.parse(b.dataset.states ?? '[]');
      const current = states.find(([v]) => v === now[attr]) ?? states[0];
      const next = states.find(([v]) => v !== current[0]) ?? current;
      b.setAttribute(attr, next[0]);
      b.title = `Switch to ${next[1]}`;
      b.querySelectorAll<HTMLElement>('[data-when]').forEach((el) => {
        el.hidden = el.dataset.when !== current[0];
      });
    });
    syncThemeColor();
  }

  // The browser's own chrome (mobile address bar, installed-app title bar)
  // takes the page's paper, whichever theme and style resolved it.
  function syncThemeColor() {
    const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    if (meta && document.body) meta.content = getComputedStyle(document.body).backgroundColor;
  }

  function setOpen(menu: Element, open: boolean) {
    menu.classList.toggle('is-open', open);
    menu.querySelector('[data-menu-trigger]')?.setAttribute('aria-expanded', String(open));
    if (open) syncMenu();
  }

  document.addEventListener('click', (e) => {
    const el = e.target as Element | null;
    const menu = document.querySelector('[data-head-menu]');
    if (!menu) return;

    if (el?.closest('[data-menu-trigger]')) {
      setOpen(menu, !menu.classList.contains('is-open'));
      return;
    }

    // Style/theme choices apply live behind the open panel — the page
    // transforms while the menu stays up, so the choice reads immediately.
    const vBtn = el?.closest<HTMLElement>('[data-variant-btn]');
    if (vBtn?.dataset.variantBtn) {
      applyVariant(vBtn.dataset.variantBtn);
      try {
        localStorage.setItem('pa-variant', vBtn.dataset.variantBtn);
      } catch {
        /* storage unavailable — switch still applies to this page */
      }
      syncMenu();
      return;
    }
    const tBtn = el?.closest<HTMLElement>('[data-theme-set]');
    if (tBtn?.dataset.themeSet) {
      document.documentElement.dataset.theme = tBtn.dataset.themeSet;
      try {
        localStorage.setItem('pa-theme', tBtn.dataset.themeSet);
      } catch {
        /* ignore */
      }
      syncMenu();
      return;
    }
    const gBtn = el?.closest<HTMLElement>('[data-glaze-set]');
    if (gBtn?.dataset.glazeSet) {
      applyGlaze(gBtn.dataset.glazeSet);
      try {
        localStorage.setItem('pa-glaze', gBtn.dataset.glazeSet);
      } catch {
        /* storage unavailable — the change still applies to this page */
      }
      syncMenu();
      return;
    }
    const uBtn = el?.closest<HTMLElement>('[data-units-set]');
    if (uBtn?.dataset.unitsSet) {
      try {
        localStorage.setItem('pa-units', uBtn.dataset.unitsSet);
      } catch {
        /* storage unavailable — conversion still applies to this page */
      }
      applyUnits(uBtn.dataset.unitsSet);
      document.dispatchEvent(new CustomEvent(UNITS_CHANGE_EVENT, { detail: uBtn.dataset.unitsSet }));
      syncMenu();
      return;
    }

    const eBtn = el?.closest<HTMLElement>('[data-engine-set]');
    if (eBtn?.dataset.engineSet) {
      // Nothing is fetched here — the engine is only consulted on the next
      // lookup, so switching costs nothing until it is used.
      setStoredEngine(eBtn.dataset.engineSet === 'local' ? 'local' : 'server');
      syncMenu();
      return;
    }

    // Anywhere else closes it.
    if (!el?.closest('[data-head-menu]')) setOpen(menu, false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const menu = document.querySelector('[data-head-menu].is-open');
    if (menu) setOpen(menu, false);
  });

  // Initial load + every swap: re-apply the stored preferences (the swap
  // resets <html>'s class list and attributes to the server-rendered
  // default) and re-sync the marks.
  function restore() {
    applyVariant(storedVariant());
    try {
      const t = localStorage.getItem('pa-theme');
      if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
    } catch {
      /* ignore */
    }
    applyGlaze(storedGlaze());
    applyUnits(storedUnits());
    syncMenu();
  }
  document.addEventListener('astro:page-load', restore);
  document.addEventListener('astro:after-swap', restore);
  // The molecule tool has the same switch; keep the marks here in step.
  document.addEventListener(ENGINE_CHANGE_EVENT, syncMenu);
</script>
