{
  "name": "polymer-atlas",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "vendor:3dmol": "node -e \"require('fs').copyFileSync('node_modules/3dmol/build/3Dmol-min.js','public/vendor/3Dmol.min.js')\"",
    "vendor:rdkit": "node -e \"const fs=require('fs');fs.mkdirSync('public/vendor/rdkit',{recursive:true});for(const f of ['RDKit_minimal.js','RDKit_minimal.wasm'])fs.copyFileSync('node_modules/@rdkit/rdkit/dist/'+f,'public/vendor/rdkit/'+f);fs.copyFileSync('node_modules/@rdkit/rdkit/LICENSE','public/vendor/rdkit/RDKit.LICENSE.txt')\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "astro": "^7.1.3",
    "katex": "^0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "3dmol": "^2.5.5",
    "pagefind": "^1.5.2",
    "typescript": "^5.6.0"
  }
}
